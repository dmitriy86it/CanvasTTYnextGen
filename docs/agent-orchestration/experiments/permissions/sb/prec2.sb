(version 1)
(deny default)
(import "system.sb")
(allow process-fork process-exec)
(allow file-read*)
(deny file-read* (subpath (param "HOME2")))
(allow file-read* (subpath (string-append (param "HOME2") "/proj")))
(allow file-read-metadata)
(allow file-write* (literal "/dev/null") (subpath (string-append (param "HOME2") "/proj")))
